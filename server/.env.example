# ---------------------------------------------------------------
# Backend secrets. Copy this file to server/.env — never commit it.
# ---------------------------------------------------------------

# Your AI provider key (kept on the server, never inside the app).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Text model used for translation + the verification pass.
OPENAI_MODEL=gpt-4o

# Vision model used to read text from photos.
OPENAI_VISION_MODEL=gpt-4o

# Port the proxy listens on (must match EXPO_PUBLIC_API_URL in the app).
PORT=3001

# Safety limits.
MAX_TEXT_LENGTH=4000
MAX_IMAGE_BYTES=8388608
RATE_LIMIT_PER_MINUTE=40