# ---------------------------------------------------------------
# All of this is OPTIONAL.
#
# With nothing here the app still works completely free: it uses the
# bundled Sanskrit dictionary and, when that is unsure, free online
# translation services. No key is needed.
#
# Add OPENAI_API_KEY only if you later want full-grammar Sanskrit and
# photo scanning (the Scan tab reads text from the camera).
# ---------------------------------------------------------------

# Enables the AI engine + photo reading. Leave empty for the free setup.
OPENAI_API_KEY=

# Translation + verification model (AI mode only).
OPENAI_MODEL=gpt-4o

# Model that reads text in photos (AI mode only).
OPENAI_VISION_MODEL=gpt-4o

# Any OpenAI-compatible provider, or a local Ollama:
#   http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# free = bundled dictionary (default). llm = AI model.
TRANSLATE_ENGINE=free

# Set to false to never call the free online services.
USE_FREE_APIS=true

# auto = photo reading only when a key is present.
OCR_ENGINE=auto

# Port (most hosts set this for you).
PORT=3001

# Safety limits.
MAX_TEXT_LENGTH=4000
MAX_IMAGE_BYTES=8388608
RATE_LIMIT_PER_MINUTE=40